# ─────────────────────────────────────────────────────────────────────────────
# LinguaFlow Backend — Environment Variables
# Copy to .env and fill in your actual values.
# NEVER commit the actual .env file to version control!
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── Database ──────────────────────────────────────────────────────────────────
# Leave DB_ENGINE=sqlite to use SQLite (default for development)
DB_ENGINE=sqlite
# DB_ENGINE=postgresql       # Uncomment to use PostgreSQL
# DB_NAME=linguaflow_db
# DB_USER=linguaflow_user
# DB_PASSWORD=linguaflow_pass
# DB_HOST=db                 # Use 'db' when running in Docker Compose
# DB_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── CORS — Vite dev server and production frontend ───────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80

# ── AI Integration ────────────────────────────────────────────────────────────
# AI Provider: 'local' | 'gemini' | 'openai' | 'fallback'
#
#   'local'    — Self-hosted model via Ollama (RECOMMENDED — no cost, no data sent externally)
#                Install Ollama: https://ollama.com/download
#                Then pull a model: ollama pull qwen2.5:7b
#
#   'gemini'   — Google Gemini API (requires GEMINI_API_KEY)
#   'openai'   — OpenAI GPT API    (requires OPENAI_API_KEY)
#   'fallback' — Offline keyword-based mock responses (no AI at all)
#
AI_PROVIDER=local

# ── Local AI (Ollama) ─────────────────────────────────────────────────────────
# Address of the running Ollama server
OLLAMA_HOST=http://localhost:11434

# The model to use — must be pulled first with: ollama pull <model>
# Recommended models by hardware:
#   GPU ≥8GB VRAM  → qwen2.5:7b  or  gemma3:4b
#   GPU  4–8GB     → qwen2.5:7b-q4_K_M  or  mistral:7b-q4_K_M
#   CPU only       → qwen2.5:1.5b  or  smollm2:1.7b
LOCAL_AI_MODEL=qwen2.5:7b

# ── External APIs (optional fallbacks) ───────────────────────────────────────
# Google Gemini — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI GPT — https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# ── Email (Production only) ────────────────────────────────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@linguaflow.app
