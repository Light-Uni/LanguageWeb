# Django
SECRET_KEY=django-insecure-linguaflow-dev-secret-key-2024
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL / SQLite
DB_ENGINE=sqlite
DB_NAME=linguaflow_db
DB_USER=linguaflow_user
DB_PASSWORD=linguaflow_pass
DB_HOST=localhost
DB_PORT=5432

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: 'local' | 'gemini' | 'openai' | 'fallback'
# Set to 'local' to use your self-hosted Ollama model (no API key needed).
AI_PROVIDER=local

# Ollama server address (default when running locally)
OLLAMA_HOST=http://localhost:11434

# The model to use — must be pulled first: `ollama pull qwen2.5:7b`
# Good options by hardware:
#   GPU ≥8GB VRAM : qwen2.5:7b  or  gemma3:4b
#   GPU  4-8GB    : qwen2.5:7b-q4_K_M  or  mistral:7b-q4_K_M
#   CPU only      : qwen2.5:1.5b  or  smollm2:1.7b
LOCAL_AI_MODEL=qwen2.5:7b

# (Optional) External API keys — only needed if AI_PROVIDER is 'gemini' or 'openai'
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
